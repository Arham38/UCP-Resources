# ── API base URL ──────────────────────────────────────────────────────────────
# Leave blank in development — Vite proxy forwards /api → http://localhost:3000
# Set in production to your backend origin:
# VITE_API_URL=https://api.yourdomain.com/api

# ── Uploads / static files base URL ───────────────────────────────────────────
# Leave blank in development — Vite proxy forwards /uploads → http://localhost:3000
# In production, set this to the backend origin so image paths resolve correctly:
# VITE_UPLOADS_URL=https://api.yourdomain.com
#
# If VITE_UPLOADS_URL is not set but VITE_API_URL is, the uploads URL is
# automatically derived by stripping /api from VITE_API_URL.

# ── Socket.io server URL ───────────────────────────────────────────────────────
# Leave blank in development (defaults to http://localhost:3000)
# VITE_SOCKET_URL=https://api.yourdomain.com
