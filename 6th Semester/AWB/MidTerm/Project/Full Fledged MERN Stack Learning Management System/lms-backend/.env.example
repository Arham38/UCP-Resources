# ─── Server Configuration ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/LMS_Final_Project

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production

# ─── Client URL (CORS) ────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── AI Configuration (Optional - for AI features) ────────────────────────────
# Choose one AI provider:

# AI Provider Selection (openai, anthropic, google, or mock for testing)
AI_PROVIDER=openai

# OpenAI (GPT-4, GPT-3.5)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# OR Anthropic (Claude)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# OR Google (Gemini)
# AI_PROVIDER=google
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_MODEL=gemini-pro

# OR Mock (for testing without API keys)
# AI_PROVIDER=mock
